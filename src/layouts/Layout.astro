---
interface Props { title: string; description?: string; active?: string; }
const { title, description = '스터디 기록, 웹 프로젝트 시연, 공개 소스.', active = '' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="color-scheme" content="light dark" />
  <meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#141414" media="(prefers-color-scheme: dark)" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title.replace(/ — DEVLOG$/, '')} — DEVLOG</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <link rel="icon" href="/assets/favicon-monochrome.svg" type="image/svg+xml" />
  <link rel="stylesheet" href="/assets/style.css" />
  <link rel="stylesheet" href="/assets/blog.css" />
  <link rel="alternate" type="application/rss+xml" title="DEVLOG 스터디" href="/rss.xml" />
  <slot name="head" />
</head>
<body>
  <div id="scroll-progress" class="scroll-progress" role="progressbar" aria-label="페이지 스크롤 위치" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" hidden><span></span></div>
  <a class="skip" href="#main">본문으로 이동</a>
  <div class="site-header-slot" id="site-header-slot"><div class="site-header-shell">
  <header class="header wrap">
    <a class="brand" href="/" aria-label="DEVLOG 홈"><span class="brand-mark" aria-hidden="true">d.</span> DEVLOG<span class="brand-note">개발 기록</span></a>
    <nav aria-label="주 메뉴">
      <a href="/studies/" aria-current={active === 'studies' ? 'page' : undefined}>스터디</a>
      <a href="/projects/" aria-current={active === 'projects' ? 'page' : undefined}>프로젝트</a>
      <a class="github-nav" href="https://github.com/ehdxo89/ehdxo89.github.io" rel="noreferrer">GitHub ↗</a>
    </nav>
  </header>
  </div></div>
  <script>
    const slot = document.querySelector<HTMLElement>('#site-header-slot')!;
    const desktop = matchMedia('(min-width: 1024px) and (hover: hover) and (pointer: fine)');
    const progress = document.querySelector<HTMLElement>('#scroll-progress')!;
    const fill = progress.querySelector<HTMLElement>('span')!;
    const updateScrollUI = () => {
      slot.classList.toggle('is-compact', desktop.matches && window.scrollY > 80);
      const range = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      const ratio = range > 0 ? Math.min(1, Math.max(0, window.scrollY / range)) : 0;
      progress.hidden = !desktop.matches || range <= 0;
      fill.style.transform = `scaleX(${ratio})`;
      progress.setAttribute('aria-valuenow', String(Math.round(ratio * 100)));
    };
    let scheduled = false;
    const scheduleUpdate = () => {
      if (scheduled) return;
      scheduled = true;
      requestAnimationFrame(() => { updateScrollUI(); scheduled = false; });
    };
    window.addEventListener('scroll', scheduleUpdate, { passive: true });
    window.addEventListener('resize', scheduleUpdate);
    desktop.addEventListener('change', scheduleUpdate);
    window.addEventListener('pageshow', scheduleUpdate);
    new ResizeObserver(scheduleUpdate).observe(document.body);
    updateScrollUI();
  </script>
  <main id="main"><slot /></main>
  <footer class="footer wrap">
    <a class="brand" href="/"><span class="brand-mark" aria-hidden="true">d.</span> DEVLOG</a>
    <p>스터디 · 프로젝트 · 코드</p>
    <div class="footer-links"><a href="/rss.xml">RSS</a><a href="/projects/">프로젝트 ↗</a></div>
  </footer>
</body>
</html>
