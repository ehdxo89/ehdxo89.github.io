---
import { dateLabel } from '../lib/posts';
const { posts } = Astro.props;
---
<div class="post-list">
  {posts.map((post) => (
    <a class="post-item" href={`/studies/${post.id}/`}>
      <div class="post-meta"><time datetime={post.data.date.toISOString()}>{dateLabel(post.data.date)}</time><span>{post.data.tags.join(' · ')}</span></div>
      <div><h3>{post.data.title}</h3><p>{post.data.description}</p></div>
      <span class="post-arrow" aria-hidden="true">↗</span>
    </a>
  ))}
</div>
