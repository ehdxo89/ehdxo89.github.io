---
import Layout from '../../layouts/Layout.astro';
import PostList from '../../components/PostList.astro';
import { publishedPosts } from '../../lib/posts';
const posts = await publishedPosts();
const tags = [...new Set(posts.flatMap(post => post.data.tags))];
---
<Layout title="스터디" description="학습 내용, 구현 과정, 검증 결과." active="studies">
<section class="wrap listing-hero"><p class="eyebrow">STUDY NOTES / {String(posts.length).padStart(2, '0')}</p><h1>스터디 기록</h1><p class="intro">학습 내용과 구현 과정 정리.</p></section>
<section class="wrap section study-index">
  <div class="study-controls" id="study-controls" hidden>
    <label for="study-search">글 검색<input id="study-search" type="search" placeholder="제목, 요약, 태그 검색" autocomplete="off" /></label>
    <label for="study-tag">주제<select id="study-tag"><option value="">전체 주제</option>{tags.map(tag => <option value={tag}>{tag}</option>)}</select></label>
    <p id="study-count" role="status" aria-live="polite">{posts.length}개의 글</p>
  </div>
  <PostList posts={posts} />
  <p id="study-empty" class="notice" hidden>검색 결과 없음. 검색어나 주제 변경 필요.</p>
  <noscript><p class="control-hint">글 읽기는 JavaScript 없이 가능. 검색·필터는 JavaScript 필요.</p></noscript>
</section>
<script>
  const input = document.querySelector<HTMLInputElement>('#study-search')!;
  const tag = document.querySelector<HTMLSelectElement>('#study-tag')!;
  const entries = [...document.querySelectorAll<HTMLAnchorElement>('.post-item')];
  const filter = () => {
    const query = input.value.trim().toLocaleLowerCase('ko');
    let visible = 0;
    entries.forEach(entry => {
      const tags = entry.querySelector('.post-meta span')!.textContent!.split(' · ');
      const match = entry.textContent!.toLocaleLowerCase('ko').includes(query) && (!tag.value || tags.includes(tag.value));
      entry.hidden = !match;
      if (match) visible++;
    });
    document.querySelector('#study-count')!.textContent = visible + '개의 글';
    (document.querySelector('#study-empty') as HTMLElement).hidden = visible > 0;
  };
  input.addEventListener('input', filter);
  tag.addEventListener('change', filter);
  document.querySelector<HTMLElement>('#study-controls')!.hidden = false;
</script>
</Layout>
